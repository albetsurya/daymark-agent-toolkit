{
  "name": "@daymark/contracts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Shared Zod v4 schemas, DTOs, and error contracts for Daymark Agent Toolkit.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
