{
  "name": "@daymark/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first productivity CLI (daymark) for tasks, planning, focus, worklogs, and backups.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "daymark": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --dts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/config": "workspace:*",
    "@daymark/contracts": "workspace:*",
    "@daymark/core": "workspace:*",
    "@daymark/storage-sqlite": "workspace:*",
    "commander": "15.1.0",
    "pino": "10.4.0"
  }
}
