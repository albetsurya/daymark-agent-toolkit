{
  "name": "@daymark/storage-sqlite",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first SQLite and Drizzle ORM storage adapter for Daymark Agent Toolkit.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "packages/storage-sqlite"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm --clean && node -e \"import('node:fs').then(fs => fs.cpSync('migrations', 'dist/migrations', { recursive: true }))\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/config": "workspace:*",
    "@daymark/contracts": "workspace:*",
    "@daymark/core": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@daymark/test-fixtures": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
