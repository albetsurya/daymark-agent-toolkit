{
  "name": "@daymark/storage-sqlite",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm --clean && node -e \"import('node:fs').then(fs => fs.cpSync('migrations', 'dist/migrations', { recursive: true }))\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/config": "workspace:*",
    "@daymark/contracts": "workspace:*",
    "@daymark/core": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@daymark/test-fixtures": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
