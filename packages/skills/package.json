{
  "name": "@daymark/skills",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Portable Agent Skills validator and bundled workflows for Daymark Agent Toolkit.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "packages/skills"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm --clean && node -e \"import('node:fs').then(fs => fs.cpSync('../../skills', 'dist/skills', { recursive: true }))\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@daymark/test-fixtures": "workspace:*"
  }
}
