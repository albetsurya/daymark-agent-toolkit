{
  "name": "@daymark/platform-adapters",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Canonical MCP and Agent Skill bundle generators for Antigravity, OpenCode, Claude Code, Codex, and Cursor.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "packages/platform-adapters"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --dts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "pack:platforms": "node dist/bin.mjs pack",
    "verify:packages": "node dist/bin.mjs verify",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/contracts": "workspace:*",
    "@daymark/skills": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@daymark/config": "workspace:*",
    "@daymark/mcp-server": "workspace:*",
    "@daymark/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0"
  }
}
