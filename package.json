{
  "name": "daymark-agent-toolkit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Daymark Agent Toolkit - local-first productivity toolkit across CLI, MCP STDIO, Web Dashboard, and Remote HTTP MCP",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "biome check packages apps",
    "format": "biome format --write packages apps",
    "format:check": "biome format packages apps",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "pack:platforms": "pnpm --filter @daymark/platform-adapters pack:platforms",
    "verify:packages": "pnpm --filter @daymark/platform-adapters verify:packages",
    "pack:npm": "node scripts/verify-release-readiness.mjs --pack",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "verify:matrix": "node scripts/verify-host-platforms.mjs",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
