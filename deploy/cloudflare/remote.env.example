# Environment configuration for Daymark Remote MCP (Streamable HTTP)
# Copy to a private local file (e.g. .env.remote — gitignored) before running.

# Required: Strong random bearer token for personal development / Claude Custom Connector
# Generate with: openssl rand -base64 32
DAYMARK_MCP_TOKEN=replace-with-strong-random-bearer-token

# Optional: Read-only bearer token (only grants 'read' scope; writes fail with FORBIDDEN)
# DAYMARK_MCP_READONLY_TOKEN=replace-with-readonly-token

# Bind strictly to loopback when sitting behind Cloudflare Tunnel
DAYMARK_MCP_HOST=127.0.0.1
DAYMARK_MCP_PORT=8787

# Comma-separated public tunnel hostnames allowed in Host header validation
# Example for Named Tunnel: daymark-mcp.yourdomain.com
# Example for Quick Tunnel dev testing: *.trycloudflare.com
DAYMARK_MCP_ALLOWED_HOSTS=daymark-mcp.yourdomain.com

# Comma-separated browser origins allowed when Origin header is present
DAYMARK_MCP_ALLOWED_ORIGINS=https://claude.ai

# Sliding-window rate limit per principal/IP
DAYMARK_MCP_RATE_LIMIT_MAX=120
DAYMARK_MCP_RATE_LIMIT_WINDOW_MS=60000

# Structured redacted diagnostic logs on stderr
DAYMARK_LOG_LEVEL=info

# Optional custom Daymark profile directory (defaults to OS standard data dir)
# DAYMARK_HOME=/path/to/daymark-profile
