{
  "name": "@daymark/web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Standalone React 19 + TypeScript Web Dashboard and 127.0.0.1 API server (daymark-web) for Daymark.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albetsurya/daymark-agent-toolkit.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/albetsurya/daymark-agent-toolkit#readme",
  "bugs": "https://github.com/albetsurya/daymark-agent-toolkit/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/server/index.mjs",
  "types": "./dist/server/index.d.mts",
  "bin": {
    "daymark-web": "./dist/server/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    }
  },
  "scripts": {
    "build:server": "tsdown src/server/index.ts src/server/bin.ts --tsconfig tsconfig.server.json --out-dir dist/server --dts --format esm --clean",
    "build:client": "vite build",
    "build": "pnpm run build:server && pnpm run build:client",
    "dev": "vite",
    "start": "node dist/server/bin.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@daymark/config": "workspace:*",
    "@daymark/contracts": "workspace:*",
    "@daymark/core": "workspace:*",
    "@daymark/storage-sqlite": "workspace:*",
    "pino": "10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@daymark/cli": "workspace:*",
    "@daymark/mcp-server": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.4.0"
  }
}
